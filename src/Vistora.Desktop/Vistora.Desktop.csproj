<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Vistora</AssemblyName>
    <Version>1.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Branding/vistora-icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Assets/Branding/vistora-icon.ico" />
    <Resource Include="Assets/Branding/vistora-icon.ico" />
    <ProjectReference Include="../Vistora.Core/Vistora.Core.csproj" />
    <ProjectReference Include="../Vistora.Infrastructure/Vistora.Infrastructure.csproj" />
    <ProjectReference Include="../Vistora.Automation.Edge/Vistora.Automation.Edge.csproj" />
  </ItemGroup>
</Project>
