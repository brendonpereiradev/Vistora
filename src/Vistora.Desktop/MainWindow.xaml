<Window x:Class="Vistora.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Vistora — Visitas preventivas" Width="1180" Height="820" MinWidth="1000" MinHeight="700" WindowStartupLocation="CenterScreen" Closing="WindowClosing">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{StaticResource Ink}">
      <DockPanel Margin="22,28">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="Vistora" FontFamily="Bahnschrift" FontSize="32" Foreground="White"/>
          <TextBlock Text="Visitas preventivas" Foreground="#BFDADE" Margin="0,3,0,32"/>
          <Button Style="{StaticResource RailButton}" Content="Executar visita" Tag="0" Click="Navigate"/>
          <Button Style="{StaticResource RailButton}" Content="Perfis e pavimentos" Tag="1" Click="Navigate"/>
          <Button Style="{StaticResource RailButton}" Content="Histórico" Tag="2" Click="Navigate"/>
          <Button Style="{StaticResource RailButton}" Content="Configurações" Tag="3" Click="Navigate"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
          <TextBlock Text="Microsoft Edge" Foreground="White" FontWeight="SemiBold"/>
          <TextBlock Text="Dados salvos neste&#10;computador" Foreground="#BFDADE" Margin="0,6,0,16"/>
          <TextBlock Text="Vistora 0.1.5" Foreground="#8CAFB8"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="30,26,30,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,18"><TextBlock x:Name="PageTitle" Text="Executar visita preventiva" FontFamily="Bahnschrift" FontSize="28"/><TextBlock x:Name="PageSubtitle" Text="Escolha a unidade e os pavimentos que você visitou." Foreground="#58727D" Margin="0,6,0,0"/></StackPanel>
      <TabControl x:Name="Pages" Grid.Row="1" BorderThickness="0" Background="Transparent" Padding="0">
        <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed"/></Style></TabControl.Resources>
        <TabItem>
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="Perfil da unidade" Style="{StaticResource Label}"/><ComboBox x:Name="ProfilePicker" DisplayMemberPath="Name" SelectionChanged="ProfileChanged"/><TextBlock x:Name="ProfileSummary" Foreground="#58727D" Margin="0,0,0,12" TextWrapping="Wrap"/><TextBlock x:Name="PendingVisitNotice" Foreground="#157A6E" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed"/></StackPanel>
              <Button x:Name="EditActiveButton" Grid.Column="1" Content="Editar perfil" Click="EditActive" VerticalAlignment="Top" Margin="14,23,0,0"/>
            </Grid>
            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="SelectionSummary" Text="Pavimentos" Style="{StaticResource Label}" Margin="0,0,0,10"/>
                <DataGrid x:Name="FloorGrid" Grid.Row="1" SelectionChanged="FloorSelected">
                  <DataGrid.Columns><DataGridTemplateColumn Header="Visitar" Width="70"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Checked="SelectionChanged" Unchecked="SelectionChanged" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Pavimento" Binding="{Binding Name}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="Setor" Binding="{Binding Sector}" IsReadOnly="True" Width="*"/></DataGrid.Columns>
                </DataGrid>
              </Grid>
              <Border Grid.Column="2" Background="#E8F2F3" Padding="18" CornerRadius="4"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Texto de fechamento" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Usado na resolução e no&#10;comentário público." Foreground="#58727D" Margin="0,6,0,12"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ResolutionPreview" Text="Selecione um pavimento para conferir seu texto." TextWrapping="Wrap" FontSize="13"/></ScrollViewer></DockPanel></Border>
            </Grid>
            <Border Grid.Row="2" Background="White" BorderBrush="#D7E1E5" BorderThickness="1" Padding="16" Margin="0,18,0,16">
              <StackPanel><TextBlock x:Name="ExecutionMessage" Text="Pronto para configurar sua primeira unidade." TextWrapping="Wrap" FontWeight="SemiBold"/><ProgressBar x:Name="RunProgress" Height="5" Margin="0,12,0,0" Foreground="{StaticResource Teal}" Background="#E5EDF0" Maximum="100"/></StackPanel>
            </Border>
            <StackPanel Grid.Row="3" Orientation="Horizontal"><Button x:Name="ExecuteButton" Style="{StaticResource Primary}" Content="Executar visita preventiva" Click="Execute"/><Button x:Name="StopButton" Content="Parar execução" IsEnabled="False" Click="Stop"/><Button x:Name="ConnectButton" Content="Verificar acesso ao Edge" Click="CheckAccess"/></StackPanel>
          </Grid>
        </TabItem>
        <TabItem>
          <DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16"><Button x:Name="NewProfileButton" Content="Novo perfil" Style="{StaticResource Primary}" Click="NewProfile"/><Button x:Name="EditProfileButton" Content="Editar" Click="EditProfile"/><Button x:Name="DuplicateButton" Content="Duplicar" Click="DuplicateProfile"/><Button x:Name="DeleteButton" Content="Excluir" Click="DeleteProfile"/></StackPanel>
            <DataGrid x:Name="ProfilesGrid" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Perfil" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Unidade" Binding="{Binding Unit}" Width="2*"/><DataGridTextColumn Header="Solicitante" Binding="{Binding ReporterName}" Width="2*"/><DataGridTextColumn Header="Pavimentos" Binding="{Binding Floors.Count}" Width="100"/></DataGrid.Columns></DataGrid>
          </DockPanel>
        </TabItem>
        <TabItem>
          <Grid><Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DataGrid x:Name="HistoryGrid" IsReadOnly="True" SelectionChanged="HistorySelected"><DataGrid.Columns><DataGridTextColumn Header="Data" Binding="{Binding DateLabel}" Width="150"/><DataGridTextColumn Header="Perfil" Binding="{Binding ProfileName}" Width="*"/><DataGridTextColumn Header="Resultado" Binding="{Binding StateLabel}" Width="*"/><DataGridTextColumn Header="Progresso" Binding="{Binding ProgressLabel}" Width="150"/></DataGrid.Columns></DataGrid>
            <TextBlock x:Name="HistoryMessage" Grid.Row="1" Margin="0,14" TextWrapping="Wrap" Text="Selecione uma execução para ver os chamados."/>
            <DataGrid x:Name="RunFloorGrid" Grid.Row="2" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Pavimento" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Chamado" Binding="{Binding IssueKey}" Width="130"/><DataGridTextColumn Header="Etapa" Binding="{Binding StageLabel}" Width="140"/><DataGridTextColumn Header="Mensagem" Binding="{Binding Message}" Width="2*"/></DataGrid.Columns></DataGrid>
            <WrapPanel Grid.Row="3" Margin="0,16,0,0"><Button x:Name="ResumeButton" Content="Retomar execução" Style="{StaticResource Primary}" Click="Resume"/><Button x:Name="LinkButton" Content="Vincular chamado" Click="LinkIssue"/><Button Content="Abrir chamado no Jira" Click="OpenIssue"/><Button Content="Abrir diagnóstico" Click="OpenDiagnostics"/></WrapPanel>
          </Grid>
        </TabItem>
        <TabItem>
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SettingsPanel" MaxWidth="650" HorizontalAlignment="Left">
            <TextBlock Text="Endereço do Jira" Style="{StaticResource Label}"/><TextBox x:Name="JiraUrlBox"/>
            <TextBlock Text="Endereço do formulário de visita preventiva" Style="{StaticResource Label}"/><TextBox x:Name="PortalUrlBox"/>
            <TextBlock Text="Endereço da fila de atendimento" Style="{StaticResource Label}"/><TextBox x:Name="QueueUrlBox"/>
            <TextBlock Text="Tempo de espera por etapa (segundos)" Style="{StaticResource Label}"/><TextBox x:Name="TimeoutBox" MaxWidth="140" HorizontalAlignment="Left"/>
            <Border Background="#E8F2F3" Padding="16" Margin="0,6,0,20"><TextBlock Text="O login é feito na janela do Microsoft Edge aberta pelo Vistora. A sessão fica salva neste computador. Trocar o perfil da unidade altera o solicitante do chamado; a conta do técnico continua sendo a conta conectada no Jira." TextWrapping="Wrap"/></Border>
            <WrapPanel><Button Content="Salvar configurações" Style="{StaticResource Primary}" Click="SaveSettings"/><Button Content="Abrir pasta de dados" Click="OpenData"/></WrapPanel>
          </StackPanel></ScrollViewer>
        </TabItem>
      </TabControl>
      <TextBlock x:Name="ClosingTeamSummary" Grid.Row="2" Foreground="#58727D" FontSize="12" Margin="0,18,0,0"/>
    </Grid>
  </Grid>
</Window>
