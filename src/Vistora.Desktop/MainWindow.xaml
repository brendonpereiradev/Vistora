<Window x:Class="Vistora.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Vistora — Visitas preventivas" Width="1180" Height="820" MinWidth="1000" MinHeight="700" WindowStartupLocation="CenterScreen" Closing="WindowClosing">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{StaticResource Ink}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="Vistora" FontFamily="Bahnschrift" FontSize="32" Foreground="White" Margin="22,28,22,0"/>
          <TextBlock Text="Visitas preventivas" Foreground="#BFDADE" Margin="22,3,22,28"/>
          <ItemsControl x:Name="RailItems" IsTabStop="False">
            <ItemsControl.ItemTemplate><DataTemplate><RadioButton Style="{StaticResource RailNav}" GroupName="Rail" Content="{Binding Name}" Checked="PageChecked" Loaded="RailItemLoaded"/></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="22,0,22,28">
          <TextBlock Text="Microsoft Edge" Foreground="White" FontWeight="SemiBold"/>
          <TextBlock Text="Dados salvos neste&#10;computador" Foreground="#BFDADE" Margin="0,6,0,16"/>
          <TextBlock Text="Vistora 0.1.5" Foreground="#8CAFB8"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="30,26,30,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,18">
        <TextBlock x:Name="PageTitle" FontFamily="Bahnschrift" FontSize="28"/>
        <TextBlock x:Name="PageSubtitle" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
      </StackPanel>
      <TabControl x:Name="Pages" Grid.Row="1" BorderBrush="Transparent" Background="Transparent" Padding="0" IsTabStop="False">
        <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed"/></Style></TabControl.Resources>

        <!-- Executar visita -->
        <TabItem>
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid x:Name="RunSetup">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Perfil da unidade" Style="{StaticResource Label}"/>
                  <ComboBox x:Name="ProfilePicker" DisplayMemberPath="Name" SelectionChanged="ProfileChanged" Margin="0,6,0,8"/>
                  <TextBlock x:Name="ProfileSummary" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
                  <TextBlock x:Name="PendingVisitNotice" Foreground="{StaticResource Amber}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>
                </StackPanel>
                <Button x:Name="EditActiveButton" Grid.Column="1" Content="Editar perfil" Click="EditActive" VerticalAlignment="Top" Margin="14,28,0,0"/>
              </Grid>
              <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                  <TextBlock x:Name="SelectionSummary" Text="Pavimentos" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                  <DataGrid x:Name="FloorGrid" Grid.Row="1" SelectionChanged="FloorSelected">
                    <DataGrid.Columns>
                      <DataGridTemplateColumn Header="Visitar" Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Checked="SelectionChanged" Unchecked="SelectionChanged" HorizontalAlignment="Left" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                      <DataGridTextColumn Header="Pavimento" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                      <DataGridTextColumn Header="Setor" Binding="{Binding Sector}" IsReadOnly="True" Width="*"/>
                    </DataGrid.Columns>
                  </DataGrid>
                </Grid>
                <Border Grid.Column="2" Background="{StaticResource Panel}" Padding="18" CornerRadius="4">
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Top"><TextBlock Text="Texto de fechamento" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Usado na resolução e no comentário público." Style="{StaticResource Hint}" Margin="0,6,0,12"/></StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False"><TextBlock x:Name="ResolutionPreview" Text="Selecione um pavimento para conferir seu texto." TextWrapping="Wrap" FontSize="13"/></ScrollViewer>
                  </DockPanel>
                </Border>
              </Grid>
            </Grid>
            <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16" Margin="0,16,0,14">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock x:Name="ExecutionMessage" Text="Pronto para configurar sua primeira unidade." TextWrapping="Wrap" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <Button x:Name="StopButton" Grid.Column="1" Content="Parar execução" Visibility="Collapsed" IsEnabled="False" Click="Stop" Padding="14,6" Margin="16,0,0,0"/>
                </Grid>
                <ProgressBar x:Name="RunProgress" Margin="0,12,0,0" Maximum="100"/>
                <ScrollViewer x:Name="RunFloorsScroll" Visibility="Collapsed" MaxHeight="96" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,12,0,0">
                  <ItemsControl x:Name="RunFloorList" IsTabStop="False">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,3,18,3" ToolTip="{Binding Message}">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="104"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="13" VerticalAlignment="Center"/>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                            <Border Width="18" Height="4" Margin="0,0,2,0" CornerRadius="2" Background="{Binding Stage, Converter={StaticResource StageSegment}, ConverterParameter=1}"/>
                            <Border Width="18" Height="4" Margin="0,0,2,0" CornerRadius="2" Background="{Binding Stage, Converter={StaticResource StageSegment}, ConverterParameter=2}"/>
                            <Border Width="18" Height="4" Margin="0,0,2,0" CornerRadius="2" Background="{Binding Stage, Converter={StaticResource StageSegment}, ConverterParameter=3}"/>
                            <Border Width="18" Height="4" CornerRadius="2" Background="{Binding Stage, Converter={StaticResource StageSegment}, ConverterParameter=4}"/>
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding StageLabel}" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="3" Text="{Binding IssueKey, TargetNullValue='—'}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>
            </Border>
            <StackPanel x:Name="RunActions" Grid.Row="2" Orientation="Horizontal">
              <Button x:Name="ExecuteButton" Style="{StaticResource Primary}" Content="Executar visita preventiva" Click="Execute"/>
              <Button x:Name="ConnectButton" Content="Verificar acesso ao Edge" Click="CheckAccess"/>
            </StackPanel>
          </Grid>
        </TabItem>

        <!-- Perfis e pavimentos -->
        <TabItem>
          <DockPanel>
            <StackPanel x:Name="ProfileActions" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
              <Button x:Name="NewProfileButton" Content="Novo perfil" Style="{StaticResource Primary}" Click="NewProfile"/>
              <Button x:Name="EditProfileButton" Content="Editar" Click="EditProfile"/>
              <Button x:Name="DuplicateButton" Content="Duplicar" Click="DuplicateProfile"/>
              <Button x:Name="DeleteButton" Content="Excluir" Click="DeleteProfile"/>
            </StackPanel>
            <DataGrid x:Name="ProfilesGrid" IsReadOnly="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Perfil" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Unidade" Binding="{Binding Unit}" Width="2*"/>
                <DataGridTextColumn Header="Solicitante" Binding="{Binding ReporterName}" Width="2*"/>
                <DataGridTextColumn Header="Pavimentos" Binding="{Binding Floors.Count}" Width="110"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>

        <!-- Histórico -->
        <TabItem>
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DataGrid x:Name="HistoryGrid" IsReadOnly="True" SelectionChanged="HistorySelected">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Data" Binding="{Binding DateLabel}" Width="160"/>
                <DataGridTextColumn Header="Perfil" Binding="{Binding ProfileName}" Width="*"/>
                <DataGridTemplateColumn Header="Resultado" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding StateLabel}" FontWeight="SemiBold" Foreground="{Binding State, Converter={StaticResource RunStateBrush}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="Progresso" Binding="{Binding ProgressLabel}" Width="150"/>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="HistoryMessage" Grid.Row="1" Margin="0,14" TextWrapping="Wrap" Text="Selecione uma execução para ver os chamados."/>
            <DataGrid x:Name="RunFloorGrid" Grid.Row="2" IsReadOnly="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Pavimento" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Chamado" Binding="{Binding IssueKey}" Width="130"/>
                <DataGridTextColumn Header="Etapa" Binding="{Binding StageLabel}" Width="150"/>
                <DataGridTextColumn Header="Mensagem" Binding="{Binding Message}" Width="2*"/>
              </DataGrid.Columns>
            </DataGrid>
            <WrapPanel Grid.Row="3" Margin="0,16,0,0">
              <StackPanel x:Name="HistoryActions" Orientation="Horizontal">
                <Button x:Name="ResumeButton" Content="Retomar execução" Style="{StaticResource Primary}" Click="Resume"/>
                <Button x:Name="LinkButton" Content="Vincular chamado" Click="LinkIssue"/>
              </StackPanel>
              <Button Content="Abrir chamado no Jira" Click="OpenIssue"/>
              <Button Content="Abrir diagnóstico" Click="OpenDiagnostics"/>
            </WrapPanel>
          </Grid>
        </TabItem>

        <!-- Configurações -->
        <TabItem>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="660"/><ColumnDefinition Width="24"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
              <StackPanel x:Name="SettingsPanel" TextBoxBase.TextChanged="SettingsEdited">
                <TextBlock Text="Endereço do Jira" Style="{StaticResource Label}"/><TextBox x:Name="JiraUrlBox"/>
                <TextBlock Text="Endereço do formulário de visita preventiva" Style="{StaticResource Label}"/><TextBox x:Name="PortalUrlBox"/>
                <TextBlock Text="Endereço da fila de atendimento" Style="{StaticResource Label}"/><TextBox x:Name="QueueUrlBox"/>
                <TextBlock Text="Tempo de espera por etapa (segundos)" Style="{StaticResource Label}"/><TextBox x:Name="TimeoutBox" Width="140" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <Button Content="Salvar configurações" Style="{StaticResource Primary}" Click="SaveSettings"/>
                  <Button Content="Abrir pasta de dados" Click="OpenData"/>
                  <TextBlock x:Name="SettingsStatus" VerticalAlignment="Center" FontWeight="SemiBold" Margin="8,0,0,0" TextWrapping="Wrap" MaxWidth="320"/>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
            <Border Grid.Column="2" Background="{StaticResource Panel}" Padding="18" CornerRadius="4" VerticalAlignment="Top">
              <StackPanel>
                <TextBlock Text="Sobre o login" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="O login é feito na janela do Microsoft Edge aberta pelo Vistora. A sessão fica salva neste computador. Trocar o perfil da unidade altera o solicitante do chamado; a conta do técnico continua sendo a conta conectada no Jira." TextWrapping="Wrap" FontSize="13"/>
              </StackPanel>
            </Border>
          </Grid>
        </TabItem>
      </TabControl>
      <TextBlock x:Name="ClosingTeamSummary" Grid.Row="2" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,14,0,0"/>
    </Grid>
  </Grid>
</Window>
